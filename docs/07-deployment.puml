
@startuml deployment
title CinemaTicket - Deployment Diagram

skinparam shadowing false
skinparam defaultFontName Arial

node "Компютери корбар" as client {
    artifact "Web Browser\nChrome / Firefox / Edge" as browser
}

node "Linux VDS\nUbuntu 24.04" as server {

    node "Nginx Web Server" as nginx {
        artifact "nginx.conf" as nginxconf
    }

    node "PHP-FPM 8.2" as php {
        artifact "CinemaTicket Application\npublic/\nconfig/\nincludes/" as app
        artifact "config/database.php" as dbconfig
    }

    database "MariaDB 10.11\nDatabase: cinematicket" as database {
    }

    folder "Storage" as storage {
        artifact "Film posters\nTicket files" as files
    }
}

browser --> nginx : HTTPS :443
nginx --> php : FastCGI
php --> database : PDO MySQL :3306
app --> storage : Read / Write files

@enduml
