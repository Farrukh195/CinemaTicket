
@startuml
title Тартиби фармоиши таксӣ

actor "Мусофир" as P
participant "Браузер" as B
participant "OrderController" as C
participant "OrderRepository" as R
database "MySQL" as DB

P -> B : Ворид кардани суроғаҳо
B -> C : POST /orders
C -> C : Санҷиши маълумот
C -> R : createOrder()
R -> DB : INSERT INTO orders
DB --> R : ID фармоиш
R --> C : Фармоиш сохта шуд

alt Ронанда ёфт шуд
C -> R : Ҷустуҷӯи ронанда
R -> DB : SELECT driver
DB --> R : Маълумоти ронанда
C --> B : 200 OK
B --> P : Фармоиш қабул шуд
else Ронанда ёфт нашуд
C --> B : 404 Not Found
B --> P : Ронанда ёфт нашуд
end

@enduml
